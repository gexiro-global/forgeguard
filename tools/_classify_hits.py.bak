"""Classify every remaining current-tree ForgeGuard occurrence for the 0.7.0 rebrand.

Categories: SCHEMA_ID | COMPATIBILITY | MIGRATION_DOC | HISTORICAL | BUG.
A BUG is an active current-product surface that still says ForgeGuard by mistake.
This helper is not part of the shipped package.
"""

import re
import subprocess
from collections import Counter
from pathlib import Path

SCHEMA_IDS = (
    "forgeguard.assessment.v1",
    "forgeguard.scan-result.v0.3",
    "forgeguard.config-snapshot.v1",
    "forgeguard.runner-snapshot.v1",
    "forgeguard.efinal-accounting.v1",
    "forgeguard.engine.datetime",
)
# Schema $id URIs are stable contract identity, deliberately not rebranded.
SCHEMA_ID_FILES = ("versionsec/schemas/",)

HISTORICAL_FILES = {
    "CHANGELOG.md",
    "docs/RELEASE_CANDIDATE_0_5.md",
    "docs/MIGRATION_0_5.md",
    "docs/BEFORE_AFTER_EXAMPLE.md",
    "ROADMAP.md",
}
MIGRATION_FILES = {"MIGRATION.md", "README.md"}
COMPAT_FILES = {"forgeguard/__init__.py", "tests/test_migration_0_7.py"}
SELF = "tools/_classify_hits.py"
# Intentional compatibility surfaces: the retained console-script alias, the shim
# package inclusion, and the CI smoke test that proves the legacy path still works.
COMPAT_MARKERS = (
    'forgeguard = "versionsec.cli:main"',
    'include = ["versionsec*", "forgeguard*"]',
    ".wheel-smoke/bin/forgeguard",
    "import forgeguard, versionsec",
)


def classify(path: str, line: str) -> str:
    if any(s in line for s in SCHEMA_IDS):
        return "SCHEMA_ID"
    if path.startswith(SCHEMA_ID_FILES) and "$id" in line:
        return "SCHEMA_ID"
    if path == SELF:
        return "MIGRATION_DOC"
    if path.startswith("qualification/") or path.startswith("examples/golden-"):
        return "HISTORICAL"
    if path in COMPAT_FILES or "FORGEGUARD_TOKEN" in line:
        return "COMPATIBILITY"
    if any(marker in line for marker in COMPAT_MARKERS):
        return "COMPATIBILITY"
    if path in MIGRATION_FILES:
        return "MIGRATION_DOC"
    if path in HISTORICAL_FILES:
        return "HISTORICAL"
    if "refs/heads/feat/forgeguard-" in line or "forgeguard-v0.5-multiforge" in line:
        return "HISTORICAL"
    if re.search(
        r"0\.2\.\d|0\.5\.0|0\.6\.0|formerly|legacy|compatibilit|previously|historic",
        line,
        re.IGNORECASE,
    ):
        return "HISTORICAL"
    return "BUG"


def main() -> None:
    out = subprocess.run(
        [
            "grep", "-rn", "-i", "forgeguard", ".",
            "--exclude-dir=.git", "--exclude-dir=__pycache__", "--exclude-dir=dist",
            "--exclude-dir=.ruff_cache", "--exclude-dir=.pytest_cache",
            "--exclude-dir=build", "--exclude-dir=.wheel-smoke",
            "--exclude=.git", "--exclude=*.bak", "--exclude-dir=versionsec.egg-info",
        ],
        capture_output=True,
        text=True,
        check=False,
    ).stdout.splitlines()

    counts: Counter = Counter()
    bugs = []
    rows = []
    for entry in out:
        try:
            path, number, line = entry.split(":", 2)
        except ValueError:
            continue
        path = path.lstrip("./")
        if path == ".git":
            continue
        verdict = classify(path, line)
        counts[verdict] += 1
        rows.append((verdict, path, number, line.strip()[:150]))
        if verdict == "BUG":
            bugs.append(f"{path}:{number}: {line.strip()[:160]}")

    report = Path("qualification/FORGEGUARD_HIT_CLASSIFICATION.md")
    report.parent.mkdir(exist_ok=True)
    with report.open("w", encoding="utf-8") as fh:
        fh.write("# Remaining ForgeGuard occurrences after the 0.7.0 rebrand\n\n")
        fh.write(
            "Generated by `tools/_classify_hits.py`. `BUG` means an active current-product\n"
            "surface that still says ForgeGuard by mistake; the release gate requires zero.\n\n"
        )
        for key in ("SCHEMA_ID", "COMPATIBILITY", "MIGRATION_DOC", "HISTORICAL", "BUG"):
            fh.write(f"- {key}: {counts[key]}\n")
        fh.write("\n## Detail\n\n")
        for verdict, path, number, line in sorted(rows):
            fh.write(f"- `{verdict}` {path}:{number} - {line}\n")

    for key in ("SCHEMA_ID", "COMPATIBILITY", "MIGRATION_DOC", "HISTORICAL", "BUG"):
        print(f"{key}: {counts[key]}")
    if bugs:
        print("\nBUGS:")
        for b in bugs:
            print(" ", b)
    raise SystemExit(1 if bugs else 0)


if __name__ == "__main__":
    main()
